# Host-side port overrides for docker-compose.yml
# Copy to .env only if you want to override these defaults or add social login credentials.

DISCOVERY_HOST_PORT=8761
CONFIG_HOST_PORT=8888
GATEWAY_HOST_PORT=8085
AUTH_HOST_PORT=8084
LIBRARY_HOST_PORT=8081
LIBRARY_REPLICA_HOST_PORT=8082
INVENTORY_HOST_PORT=8083
ZIPKIN_HOST_PORT=9412
MYSQL_LIBRARY_HOST_PORT=3306
MYSQL_INVENTORY_HOST_PORT=3307
MYSQL_AUTH_HOST_PORT=3308
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025

# Optional social login settings for auth-service
AUTH_OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:8085/
AUTH_OAUTH2_CALLBACK_REDIRECT_URI=http://localhost:8085/auth/login/oauth2/code/{registrationId}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
